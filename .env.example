# Saleor GraphQL API endpoint.
# - Use your own free instance from https://cloud.saleor.io/ (recommended, has demo apparel data)
# - Or a self-hosted Saleor instance: http://localhost:8000/graphql/
# - The default below is a public Saleor staging instance for quick testing.
NEXT_PUBLIC_SALEOR_API_URL=https://master.staging.saleor.cloud/graphql/

# Saleor channel slug used for storefront queries (pricing, availability).
NEXT_PUBLIC_SALEOR_CHANNEL=default-channel

# Set to "true" to use Saleor as the product source.
# When "false" (or unset), the app uses the built-in static product catalog.
NEXT_PUBLIC_USE_SALEOR=true
