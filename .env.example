# ==============================================================================
# TDSSNEAKERS — Environment configuration
# Copy to .env.local and fill in the values.
# ==============================================================================

# ---- Database (Supabase Postgres) --------------------------------------------
# From Supabase dashboard: Project Settings > Database > Connection string (URI).
# Use the "Session"/pooler connection string (port 6543) for serverless.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432), used for migrations only.
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# ---- Supabase (Auth + Storage) -----------------------------------------------
# From Supabase dashboard: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only key (never expose to the client). Used for storage uploads / admin.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Storage bucket name for product images.
SUPABASE_STORAGE_BUCKET="product-images"

# ---- Stripe (payments) -------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Resend (transactional emails) -------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="TDSSNEAKERS <commandes@tdssneakers.ca>"

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Comma-separated list of admin emails allowed into /admin.
ADMIN_EMAILS="admin@tdssneakers.ca"
