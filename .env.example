# ==============================================================================
# TDSSNEAKERS — Environment configuration
# Copy to .env.local and fill in the values.
# ==============================================================================

# ---- Database (Neon Postgres) ------------------------------------------------
# Easiest path: on Vercel, Storage > Create Database > Neon. Vercel injects
# DATABASE_URL automatically. Locally: `vercel env pull .env.local`.
# Or paste a Neon/Postgres connection string directly.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional direct (non-pooled) URL used for migrations.
DIRECT_URL=""

# ---- Admin access ------------------------------------------------------------
# Password to access /admin. While empty, admin runs in open demo mode.
ADMIN_PASSWORD="change-me"
# Optional: dedicated secret for signing the admin session cookie.
ADMIN_SESSION_SECRET=""

# ---- Image uploads (Vercel Blob) ---------------------------------------------
# On Vercel: Storage > Create > Blob. The token is injected automatically.
# Locally: `vercel env pull .env.local`. Without it, admins paste image URLs.
BLOB_READ_WRITE_TOKEN=""

# ---- Stripe (payments) -------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Resend (transactional emails) -------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="TDSSNEAKERS <commandes@tdssneakers.ca>"

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
